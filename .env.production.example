# ==============================================================================
# PADAIDI RENT CAR - GOOGLE CLOUD RUN PRODUCTION ENVIRONMENT
# ==============================================================================

APP_NAME="Padaidi Rent Car"
APP_ENV=production
APP_KEY=base64:c5L2n3... # Generate via: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://padaidi-web-xxxx.a.run.app
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# OPSI A: Google Cloud SQL (MySQL 8.0) - Disarankan untuk produksi penuh
DB_CONNECTION=mysql
DB_SOCKET=/cloudsql/PROJECT_ID:asia-southeast2:padaidi-db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=padaidi
DB_USERNAME=padaidi_user
DB_PASSWORD=your_secure_db_password

# OPSI B: Serverless SQLite (Sangat praktis untuk demonstrasi / staging cepat)
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/database/database.sqlite

# ------------------------------------------------------------------------------
# AUTOMATED MIGRATIONS & SEEDING ON STARTUP
# ------------------------------------------------------------------------------
# Set "true" agar container otomatis mengeksekusi migrasi & seeder armada mobil saat start
AUTO_MIGRATE=true
AUTO_SEED=true

# ------------------------------------------------------------------------------
# SESSION & CACHE (Disimpan di database atau cookie)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# FILESYSTEM / STORAGE
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (MIDTRANS / QRIS)
# ------------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# ------------------------------------------------------------------------------
# WHATSAPP CS NOTIFICATION
# ------------------------------------------------------------------------------
WHATSAPP_CS_NUMBER=6281234567890

